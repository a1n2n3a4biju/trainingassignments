CREATE OR REPLACE PROCEDURE assign_technician(
p_booking_id INT,
p_technician_id INT
)
LANGUAGE plpgsql
AS $$
BEGIN
UPDATE service_bookings
set technician_id=p_technician_id
WHERE booking_id=p_booking_id;
END ;
$$;

